# Server
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rumion?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# External discovery API (already deployed, read-only novel source)
EXTERNAL_NOVEL_API=https://novel-api.nabaikabaiaguo.workers.dev
